  updatedAt         DateTime                                   @updatedAt
  completedAt       DateTime?
  nodes             dedicated_line_migration_nodes[]
  domains           dedicated_line_domains[]                   @relation("DedicatedMigrationDomains")
  routes            delivery_routes[]                          @relation("DedicatedMigrationRoutes")
