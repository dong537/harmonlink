model dedicated_line_migrations {
  id                String                                     @id @default(uuid())
  siteId            String
  site              sites                                      @relation(fields: [siteId], references: [id])
  lineId            String
  line              dedicated_lines                            @relation(fields: [lineId], references: [id])
  sourceNodeId      String?
  sourceNode        dedicated_nodes?                           @relation("DedicatedMigrationSourceNode", fields: [sourceNodeId], references: [id])
  targetNodeId      String
  targetNode        dedicated_nodes                            @relation("DedicatedMigrationTargetNode", fields: [targetNodeId], references: [id])
