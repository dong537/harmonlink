model dedicated_nodes {
  id                          String                                     @id @default(uuid())
  siteId                      String
  site                        sites                                      @relation(fields: [siteId], references: [id])
  code                        String
  region                      String
  nodeGroupId                 String?
  status                      DedicatedNodeStatus
  managementHost              String
  managementPort              Int
  managementBasePathEncrypted String
  apiTokenEncrypted           String
  tlsMode                     DedicatedTlsMode
  tlsServerName               String?
  buildId                     String?
  capabilityVersion           String?
  capacityUnits               Int
  allocatedUnits              Int                                        @default(0)
  reservedUnits               Int                                        @default(0)
  lastHealthyAt               DateTime?
  consecutiveFailures         Int                                        @default(0)
  healthIncidentVersion       Int                                        @default(0)
  healthIncidentOpen          Boolean                                    @default(false)
  drainReason                 String?
  configVersion               Int                                        @default(0)
  createdAt                   DateTime                                   @default(now())
  updatedAt                   DateTime                                   @updatedAt
  profiles                    dedicated_node_profiles[]
  projections                 dedicated_line_projections[]
  current_lines               dedicated_lines[]                          @relation("DedicatedLineCurrentNode")
  source_migrations           dedicated_line_migrations[]                @relation("DedicatedMigrationSourceNode")
  target_migrations           dedicated_line_migrations[]                @relation("DedicatedMigrationTargetNode")
  placement_policy_nodes      line_placement_policy_nodes[]
  migration_nodes             dedicated_line_migration_nodes[]
  health_observations         control_node_health_observations[]
  health_alerts               control_node_health_alert_outbox[]
  migration_recommendations   dedicated_line_migration_recommendations[]

  @@unique([siteId, code])
  @@unique([managementHost, managementPort])
  @@index([siteId, status, region])
}

model dedicated_node_profiles {
  id                 String                     @id @default(uuid())
  nodeId             String
  node               dedicated_nodes            @relation(fields: [nodeId], references: [id])
  skuProfileId       String
  skuProfile         dedicated_sku_profiles     @relation(fields: [skuProfileId], references: [id])
