  stock               Int
  reservedQuantity    Int                                @default(0)
  capturedAt          DateTime
  freshnessTtlSeconds Int                                @default(300)
  rawSummary          Json?
  createdAt           DateTime                           @default(now())
  reservations        dedicated_inventory_reservations[]
  alert_outbox        dedicated_inventory_alert_outbox[]

  @@index([siteId, skuProfileId, capturedAt])
  @@index([providerAccountId, skuProfileId, capturedAt])
}

model dedicated_inventory_reservations {
  id             String                              @id @default(uuid())
  siteId         String
  site           sites                               @relation(fields: [siteId], references: [id])
  skuProfileId   String
  skuProfile     dedicated_sku_profiles              @relation(fields: [skuProfileId], references: [id])
  snapshotId     String
  snapshot       dedicated_inventory_snapshots       @relation(fields: [snapshotId], references: [id])
