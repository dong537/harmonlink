  recommendations   dedicated_line_migration_recommendations[]
  exitReservations  dedicated_exit_reservations[]
  commands          dedicated_line_migration_commands[]

  @@index([siteId, status])
  @@index([lineId, status])
}

model dedicated_line_placement_policies {
