  inventoryTtlSeconds    Int                                 @default(300)
  config                 Json
  createdAt              DateTime                            @default(now())
  updatedAt              DateTime                            @updatedAt
  node_profiles          dedicated_node_profiles[]
  dedicated_lines        dedicated_lines[]
  inventory_snapshots    dedicated_inventory_snapshots[]
  inventory_reservations dedicated_inventory_reservations[]
  inventory_alert_outbox dedicated_inventory_alert_outbox[]
  placement_policies     dedicated_line_placement_policies[]

  @@unique([siteId, code])
  @@index([siteId, status, clientProtocol])
}

model dedicated_inventory_snapshots {
