  remoteInboundId    String?
  remoteInboundTag   String
  listenPort         Int
  clientConfig       Json?
  observedVersion    Int?
  observedConfigHash String?
  lastErrorCode      String?
  lastReconciledAt   DateTime?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  @@unique([nodeId, skuProfileId])
  @@unique([nodeId, listenPort])
  @@index([skuProfileId, status])
}

model dedicated_lines {
  id                       String                                     @id @default(uuid())
  siteId                   String
  site                     sites                                      @relation(fields: [siteId], references: [id])
  tenantId                 String
  tenant                   tenants                                    @relation(fields: [tenantId], references: [id])
  userId                   String
  user                     users                                      @relation(fields: [userId], references: [id])
  orderId                  String?                                    @unique
  order                    orders?                                    @relation(fields: [orderId], references: [id])
  skuProfileId             String
  skuProfile               dedicated_sku_profiles                     @relation(fields: [skuProfileId], references: [id])
  status                   DedicatedLineStatus
  currentNodeId            String?
  currentNode              dedicated_nodes?                           @relation("DedicatedLineCurrentNode", fields: [currentNodeId], references: [id])
  currentExitId            String?
  currentExit              dedicated_exits?                           @relation("DedicatedLineCurrentExit", fields: [currentExitId], references: [id])
  clientEmail              String
  clientIdentityEncrypted  String
  expiresAt                DateTime
  desiredVersion           Int                                        @default(1)
  activeMigrationId        String?                                    @unique
  activeMigration          dedicated_line_migrations?                 @relation("DedicatedLineActiveMigration", fields: [activeMigrationId], references: [id])
  lastObservedVersion      Int?
  lastObservedConfigHash   String?
  failureReason            String?
  createdAt                DateTime                                   @default(now())
  updatedAt                DateTime                                   @updatedAt
  projections              dedicated_line_projections[]
  endpoints                dedicated_line_endpoints[]
  migrations               dedicated_line_migrations[]
  activeDomains            dedicated_line_domains[]                   @relation("DedicatedLineDomains")
  deliveryRoutes           delivery_routes[]                          @relation("DedicatedLineDeliveryRoutes")
  smokeObservations        dedicated_line_smoke_observations[]        @relation("DedicatedLineSmokeObservations")
  migrationRecommendations dedicated_line_migration_recommendations[] @relation("DedicatedLineMigrationRecommendations")
  domainChanges            dedicated_line_domain_changes[]

  @@index([siteId, tenantId, userId, status])
  @@index([currentNodeId, status])
  @@index([currentExitId, status])
}

model dedicated_line_projections {
  id                 String                    @id @default(uuid())
  lineId             String
