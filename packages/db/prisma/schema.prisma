generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SiteStatus {
  ACTIVE
  MAINTENANCE
  DISABLED
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum KycStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

enum RiskStatus {
  NORMAL
  FLAGGED
  BLOCKED
}

enum AdminRole {
  PLATFORM_ADMIN
  TENANT_ADMIN
  OPERATOR
}

enum AdminStatus {
  ACTIVE
  SUSPENDED
}

enum OwnerType {
  USER
  ADMIN_USER
}

enum ApiKeyOwnerType {
  USER
  TENANT_ADMIN
}

enum ApiKeyStatus {
  ACTIVE
  REVOKED
}

enum LedgerEntryType {
  DEPOSIT
  DEBIT
  REFUND
  ADJUSTMENT
  FREEZE
  UNFREEZE
  RENEWAL
  COMMISSION
}

enum PaymentChannel {
  MANUAL
  YIPAY
  ALIPAY
}

enum PaymentOrderStatus {
  PENDING
  CONFIRMING
  COMPLETED
  FAILED
  REFUNDED
}

enum AuditActorType {
  USER
  ADMIN_USER
  SYSTEM
  APIKEY
}

enum TicketStatus {
  OPEN
  PENDING
  CLOSED
}

enum TicketMessageAuthorType {
  USER
  ADMIN_USER
}

enum DedicatedLineStatus {
  PENDING_PAYMENT
  QUEUED
  PROVISIONING
  ACTIVE
  DEGRADED
  SUSPENDED
  EXPIRED
  MIGRATING_AWAITING_ROUTE_IMPORT
  CANCELLING
  CANCELLED
  FAILED
}

enum DedicatedLineProtocol {
  VLESS
  VMESS
  MIXED
}

enum PlacementMode {
  ACTIVE_ACTIVE
  HOT_STANDBY
}

enum ControlNodeStatus {
  ACTIVE
  DRAINING
  DISABLED
}

enum ProjectionStatus {
  PENDING
  APPLYING
  READY
  FAILED
  DELETING
  DELETED
}

enum ResidentialExitStatus {
  AVAILABLE
  RESERVED
  ASSIGNED
  QUARANTINED
  EXPIRED
  RELEASED
}

enum ExitAssignmentStatus {
  ACTIVE
  RELEASING
  RELEASED
}

enum LineDomainRole {
  PRIMARY
  BACKUP
}

enum LineDomainStatus {
  ACTIVE
  RETIRED
}

enum DedicatedLineMigrationType {
  NODE_ONLY
  EXIT_ONLY
  FULL
}

enum DedicatedLineMigrationPhase {
  PREPARE
  CANARY_ROUTE
  VERIFY
  CUTOVER_ROUTE
  COMMIT
  CLEANUP
  ROLLBACK
}

enum DedicatedLineMigrationStatus {
  ACTIVE
  NEEDS_OPERATOR
  COMPLETED
  CANCELLED
  FAILED
}

enum DedicatedLineMigrationNodeRole {
  SOURCE
  TARGET
}

enum MigrationNodeReservationStatus {
  RESERVED
  RELEASED
}

enum MigrationSmokeStage {
  CANARY
  CUTOVER
  ROLLBACK
}

enum DeliveryRouteStage {
  INITIAL
  CANARY
  CUTOVER
  ROLLBACK
}

enum MigrationRecommendationStatus {
  ACTIVE
  RESOLVED
  DISMISSED
}

enum InventoryReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
  EXPIRED
}

enum ExternalJobStatus {
  QUEUED
  LEASED
  RETRYING
  COMPLETED
  FAILED
  NEEDS_OPERATOR
}

enum OutboxEventStatus {
  PENDING
  LEASED
  RETRYING
  PUBLISHED
  FAILED
  NEEDS_OPERATOR
}

enum FederatedUpstreamKind {
  PLATFORM_365
  NINE_EIGHT_FIVE
  IPIPD
}

enum FederatedUpstreamStatus {
  ACTIVE
  DISABLED
}

enum FederatedScanStatus {
  SUCCESS
  FAILED
}

model sites {
  id                                 String                               @id @default(uuid())
  code                               String                               @unique
  name                               String
  domain                             String                               @unique
  status                             SiteStatus
  brandConfig                        Json?
  maintenanceMode                    Boolean                              @default(false)
  maintenanceMessage                 String?
  createdAt                          DateTime                             @default(now())
  updatedAt                          DateTime                             @updatedAt
  tenants                            tenants[]
  users                              users[]
  admin_users                        admin_users[]
  sessions                           sessions[]
  api_keys                           api_keys[]
  wallets                            wallets[]
  system_settings                    system_settings[]
  provider_accounts                  provider_accounts[]
  platform_resources                 platform_resources[]
  price_templates                    price_templates[]
  sku_price_rules                    sku_price_rules[]
  sku_price_overrides                sku_price_overrides[]
  user_sku_price_overrides           user_sku_price_overrides[]
  upstream_api_accounts              upstream_api_accounts[]
  site_announcements                 site_announcements[]
  service_skus                       service_skus[]
  residential_exits                  residential_exits[]
  node_groups                        node_groups[]
  control_nodes                      control_nodes[]
  inbound_profiles                   inbound_profiles[]
  line_placement_policies            line_placement_policies[]
  dedicated_line_orders              dedicated_line_orders[]
  dedicated_lines                    dedicated_lines[]
  delivery_route_imports             delivery_route_imports[]
  dedicated_line_inventory_snapshots dedicated_line_inventory_snapshots[]
  stock_reservations                 stock_reservations[]
  external_jobs                      external_jobs[]
  outbox_events                      outbox_events[]
  exit_health_observations           exit_health_observations[]
  dedicated_line_placements          dedicated_line_placements[]
  dedicated_line_placement_nodes     dedicated_line_placement_nodes[]
  dedicated_line_projections         dedicated_line_projections[]
  dedicated_line_exit_assignments    dedicated_line_exit_assignments[]
  delivery_routes                    delivery_routes[]
  line_placement_policy_nodes        line_placement_policy_nodes[]
  dedicated_line_domains             dedicated_line_domains[]
  dedicated_line_migrations          dedicated_line_migrations[]
  dedicated_line_domain_binding_operations dedicated_line_domain_binding_operations[]
  dedicated_line_smoke_observations  dedicated_line_smoke_observations[]
  control_node_health_observations   control_node_health_observations[]
  migration_recommendations          dedicated_line_migration_recommendations[]
  migration_recommendation_nodes     dedicated_line_migration_recommendation_nodes[]
  federated_upstream_connections     federated_upstream_connections[]
  federated_upstream_scans           federated_upstream_scans[]
}

model site_announcements {
  id        String    @id @default(uuid())
  siteId    String
  title     String
  content   String
  isActive  Boolean   @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  site      sites     @relation(fields: [siteId], references: [id])
}

model tenants {
  id                              String                            @id @default(uuid())
  siteId                          String
  site                            sites                             @relation(fields: [siteId], references: [id])
  ownerUserId                     String?
  ownerUser                       users?                            @relation("OwnedTenants", fields: [ownerUserId], references: [id])
  code                            String
  name                            String
  status                          TenantStatus
  brandConfig                     Json?
  createdAt                       DateTime                          @default(now())
  updatedAt                       DateTime                          @updatedAt
  users                           users[]
  admin_users                     admin_users[]
  api_keys                        api_keys[]
  wallets                         wallets[]
  provider_accounts               provider_accounts[]
  price_templates                 price_templates[]
  user_sku_price_overrides        user_sku_price_overrides[]
  residential_exits               residential_exits[]
  node_groups                     node_groups[]
  control_nodes                   control_nodes[]
  line_placement_policies         line_placement_policies[]
  dedicated_line_orders           dedicated_line_orders[]
  dedicated_lines                 dedicated_lines[]
  stock_reservations              stock_reservations[]
  exit_health_observations        exit_health_observations[]
  dedicated_line_placements       dedicated_line_placements[]
  dedicated_line_placement_nodes  dedicated_line_placement_nodes[]
  dedicated_line_projections      dedicated_line_projections[]
  dedicated_line_exit_assignments dedicated_line_exit_assignments[]
  delivery_routes                 delivery_routes[]
  dedicated_line_migrations       dedicated_line_migrations[]
  dedicated_line_domain_binding_operations dedicated_line_domain_binding_operations[]
  dedicated_line_smoke_observations dedicated_line_smoke_observations[]
  migration_recommendations       dedicated_line_migration_recommendations[]
  external_jobs                   external_jobs[]
  outbox_events                   outbox_events[]
  federated_upstream_connections  federated_upstream_connections[]
  federated_upstream_scans        federated_upstream_scans[]

  @@unique([siteId, code])
  @@index([siteId, ownerUserId])
}

model users {
  id                              String                            @id @default(uuid())
  siteId                          String
  site                            sites                             @relation(fields: [siteId], references: [id])
  tenantId                        String
  tenant                          tenants                           @relation(fields: [tenantId], references: [id])
  email                           String
  passwordHash                    String
  name                            String?
  phone                           String?
  status                          UserStatus
  kycStatus                       KycStatus
  riskStatus                      RiskStatus
  createdAt                       DateTime                          @default(now())
  updatedAt                       DateTime                          @updatedAt
  wallets                         wallets[]
  payment_orders                  payment_orders[]
  user_price_bindings             user_price_bindings[]
  user_resource_price_overrides   user_resource_price_overrides[]
  user_sku_price_overrides        user_sku_price_overrides[]
  orders                          orders[]
  proxy_instances                 proxy_instances[]
  tickets                         tickets[]
  notifications                   notifications[]
  ownedTenants                    tenants[]                         @relation("OwnedTenants")
  dedicated_line_orders           dedicated_line_orders[]
  dedicated_lines                 dedicated_lines[]
  stock_reservations              stock_reservations[]
  exit_health_observations        exit_health_observations[]        @relation("ExitHealthUsers")
  line_placement_policies         line_placement_policies[]         @relation("PlacementPolicyUsers")
  line_placements                 dedicated_line_placements[]       @relation("LinePlacementUsers")
  placement_nodes                 dedicated_line_placement_nodes[]  @relation("PlacementNodeUsers")
  dedicated_line_projections      dedicated_line_projections[]      @relation("ProjectionUsers")
  dedicated_line_exit_assignments dedicated_line_exit_assignments[] @relation("ExitAssignmentUsers")
  delivery_routes                 delivery_routes[]                 @relation("DeliveryRouteUsers")
  dedicated_line_migrations       dedicated_line_migrations[]       @relation("LineMigrationUsers")
  dedicated_line_domain_binding_operations dedicated_line_domain_binding_operations[]
  dedicated_line_smoke_observations dedicated_line_smoke_observations[] @relation("LineSmokeUsers")
  migration_recommendations       dedicated_line_migration_recommendations[] @relation("MigrationRecommendationUsers")
  external_jobs                   external_jobs[]                   @relation("ExternalJobUsers")
  outbox_events                   outbox_events[]                   @relation("OutboxEventUsers")

  // Sites share one database, so identity is site-scoped like tenants/service_skus.
  // Global uniqueness would both block one person from holding accounts on two
  // sites and let signup on site A reveal that an account exists on site B.
  @@unique([siteId, email])
}

model admin_users {
  id           String      @id @default(uuid())
  siteId       String
  site         sites       @relation(fields: [siteId], references: [id])
  tenantId     String?
  tenant       tenants?    @relation(fields: [tenantId], references: [id])
  email        String
  passwordHash String
  role         AdminRole
  status       AdminStatus
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  // Deliberately NOT [siteId, tenantId, email]. `tenantId` is nullable for
  // site-global admins, and Postgres treats NULLs as distinct, so a tenant-aware
  // key would place no constraint at all on PLATFORM_ADMIN rows. Login also
  // resolves an admin by (siteId, email) with no tenant in hand, so the key must
  // make that lookup unique.
  @@unique([siteId, email])
}

model sessions {
  id        String    @id @default(uuid())
  ownerType OwnerType
  ownerId   String
  siteId    String
  site      sites     @relation(fields: [siteId], references: [id])
  tenantId  String?
  token     String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
}

model api_keys {
  id          String          @id @default(uuid())
  siteId      String
  site        sites           @relation(fields: [siteId], references: [id])
  tenantId    String
  tenant      tenants         @relation(fields: [tenantId], references: [id])
  ownerId     String
  ownerType   ApiKeyOwnerType
  name        String
  keyHash     String          @unique
  keyPrefix   String
  scopes      String[]
  ipWhitelist String[]
  status      ApiKeyStatus
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  revokedAt   DateTime?
  lastUsedAt  DateTime?
}

model wallets {
  id             String           @id @default(uuid())
  siteId         String
  site           sites            @relation(fields: [siteId], references: [id])
  tenantId       String
  tenant         tenants          @relation(fields: [tenantId], references: [id])
  userId         String           @unique
  user           users            @relation(fields: [userId], references: [id])
  available      Decimal          @db.Decimal(20, 8)
  frozen         Decimal          @db.Decimal(20, 8)
  currency       String
  version        Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  ledger_entries ledger_entries[]
}

model ledger_entries {
  id             String          @id @default(uuid())
  siteId         String
  tenantId       String
  walletId       String
  wallet         wallets         @relation(fields: [walletId], references: [id])
  userId         String
  type           LedgerEntryType
  amount         Decimal         @db.Decimal(20, 8)
  balanceAfter   Decimal         @db.Decimal(20, 8)
  currency       String
  relatedId      String?
  reason         String?
  idempotencyKey String          @unique
  createdAt      DateTime        @default(now())
  meta           Json?
}

model payment_orders {
  id             String             @id @default(uuid())
  siteId         String
  tenantId       String
  userId         String
  user           users              @relation(fields: [userId], references: [id])
  amount         Decimal            @db.Decimal(20, 8)
  currency       String
  channel        PaymentChannel
  status         PaymentOrderStatus
  idempotencyKey String             @unique
  channelOrderId String?
  confirmedBy    String?
  confirmedAt    DateTime?
  failReason     String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  meta           Json?
}

model audit_logs {
  id         String         @id @default(uuid())
  siteId     String
  tenantId   String?
  actorType  AuditActorType
  actorId    String
  targetType String?
  targetId   String?
  action     String
  reason     String?
  requestId  String
  ipAddress  String?
  meta       Json?
  createdAt  DateTime       @default(now())
}

model system_settings {
  id          String   @id @default(uuid())
  siteId      String
  site        sites    @relation(fields: [siteId], references: [id])
  key         String
  value       String
  description String?
  updatedBy   String?
  updatedAt   DateTime @updatedAt

  @@unique([siteId, key])
}

enum UpstreamRequestStatus {
  SUCCESS
  ERROR
  TIMEOUT
}

enum ProviderAccountStatus {
  ACTIVE
  DISABLED
}

enum UpstreamApiAccountStatus {
  ACTIVE
  DISABLED
}

model upstream_request_logs {
  id                String                @id @default(uuid())
  siteId            String
  providerCode      String
  upstreamAccountId String?
  operation         String
  requestId         String
  durationMs        Int
  status            UpstreamRequestStatus
  errorCode         String?
  requestSummary    Json?
  responseSummary   Json?
  createdAt         DateTime              @default(now())
}

model provider_accounts {
  id                                 String                               @id @default(uuid())
  siteId                             String
  site                               sites                                @relation(fields: [siteId], references: [id])
  tenantId                           String?
  tenant                             tenants?                             @relation(fields: [tenantId], references: [id])
  providerCode                       String
  status                             ProviderAccountStatus
  credentialEncrypted                String
  baseUrl                            String
  timeoutMs                          Int                                  @default(15000)
  inventorySyncEnabled               Boolean                              @default(false)
  enabledCountryCodes                String[]                             @default([])
  createdAt                          DateTime                             @default(now())
  updatedAt                          DateTime                             @updatedAt
  residential_exits                  residential_exits[]
  dedicated_line_inventory_snapshots dedicated_line_inventory_snapshots[]
  stock_reservations                 stock_reservations[]

  @@index([siteId, tenantId, providerCode, status])
}

enum ResourceType {
  COUNTRY
  REGION
  ZONE
}

enum IpType {
  NATIVE
  BROADCAST
  BOTH
}

enum Protocol {
  HTTP
  SOCKS5
  BOTH
}

enum ResourceStatus {
  ACTIVE
  HIDDEN
  DISABLED
}

model platform_resources {
  id                            String                          @id @default(uuid())
  siteId                        String
  site                          sites                           @relation(fields: [siteId], references: [id])
  upstreamAccountId             String?
  parentId                      String?
  parent                        platform_resources?             @relation("ResourceChildren", fields: [parentId], references: [id])
  children                      platform_resources[]            @relation("ResourceChildren")
  type                          ResourceType
  code                          String
  name                          String
  displayName                   String?
  providerCode                  String
  ipType                        IpType
  protocol                      Protocol
  status                        ResourceStatus
  sortOrder                     Int                             @default(0)
  upstreamCost                  Decimal?                        @db.Decimal(20, 8)
  upstreamCostCurrency          String?
  isVisible                     Boolean                         @default(true)
  isSaleable                    Boolean                         @default(true)
  unsaleableReason              String?
  createdAt                     DateTime                        @default(now())
  updatedAt                     DateTime                        @updatedAt
  inventory_snapshots           inventory_snapshots[]
  resource_mappings             resource_mappings[]
  price_rules                   price_rules[]
  price_overrides               price_overrides[]
  user_resource_price_overrides user_resource_price_overrides[]
  orders                        orders[]

  @@unique([siteId, providerCode, upstreamAccountId, code, ipType], map: "platform_resources_site_provider_account_code_iptype_key")
  @@index([siteId, providerCode, upstreamAccountId, status], map: "platform_resources_site_provider_account_status_idx")
}

model inventory_snapshots {
  id                  String             @id @default(uuid())
  siteId              String
  resourceId          String
  resource            platform_resources @relation(fields: [resourceId], references: [id])
  providerCode        String
  upstreamAccountId   String?
  stock               Int
  capturedAt          DateTime
  freshnessTtlSeconds Int                @default(300)
  isStale             Boolean            @default(false)
}

model resource_mappings {
  id                 String             @id @default(uuid())
  siteId             String
  resourceId         String
  resource           platform_resources @relation(fields: [resourceId], references: [id])
  providerCode       String
  upstreamAccountId  String?
  providerResourceId String
  weight             Int                @default(100)

  @@unique([siteId, resourceId, providerCode, upstreamAccountId], map: "resource_mappings_site_resource_provider_account_key")
}

model price_templates {
  id                  String                @id @default(uuid())
  siteId              String
  site                sites                 @relation(fields: [siteId], references: [id])
  tenantId            String?
  tenant              tenants?              @relation(fields: [tenantId], references: [id])
  name                String
  description         String?
  isDefault           Boolean               @default(false)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  price_rules         price_rules[]
  sku_price_rules     sku_price_rules[]
  user_price_bindings user_price_bindings[]

  @@index([siteId, tenantId])
}

model price_rules {
  id           String             @id @default(uuid())
  siteId       String
  templateId   String
  template     price_templates    @relation(fields: [templateId], references: [id])
  resourceId   String
  resource     platform_resources @relation(fields: [resourceId], references: [id])
  durationDays Int
  unitPrice    Decimal            @db.Decimal(20, 8)
  currency     String
  minQty       Int                @default(1)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@unique([siteId, templateId, resourceId, durationDays])
}

model price_overrides {
  id           String             @id @default(uuid())
  siteId       String
  resourceId   String
  resource     platform_resources @relation(fields: [resourceId], references: [id])
  durationDays Int
  unitPrice    Decimal            @db.Decimal(20, 8)
  currency     String

  @@unique([siteId, resourceId, durationDays])
}

model user_price_bindings {
  id         String          @id @default(uuid())
  siteId     String
  tenantId   String
  userId     String
  user       users           @relation(fields: [userId], references: [id])
  templateId String
  template   price_templates @relation(fields: [templateId], references: [id])

  @@unique([siteId, userId])
}

model user_resource_price_overrides {
  id           String             @id @default(uuid())
  siteId       String
  tenantId     String
  userId       String
  user         users              @relation(fields: [userId], references: [id])
  resourceId   String
  resource     platform_resources @relation(fields: [resourceId], references: [id])
  durationDays Int
  unitPrice    Decimal            @db.Decimal(20, 8)
  currency     String

  @@unique([siteId, userId, resourceId, durationDays])
}

model sku_price_rules {
  id           String          @id @default(uuid())
  siteId       String
  site         sites           @relation(fields: [siteId], references: [id])
  templateId   String
  template     price_templates @relation(fields: [templateId], references: [id], onDelete: Cascade)
  skuId        String
  sku          service_skus    @relation(fields: [skuId], references: [id], onDelete: Cascade)
  durationDays Int
  minQty       Int             @default(1)
  unitPrice    Decimal         @db.Decimal(20, 8)
  currency     String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([siteId, templateId, skuId, durationDays, minQty], map: "sku_price_rules_scope_tier_key")
  @@index([siteId, skuId, durationDays, minQty], map: "sku_price_rules_lookup_idx")
}

model sku_price_overrides {
  id           String       @id @default(uuid())
  siteId       String
  site         sites        @relation(fields: [siteId], references: [id])
  skuId        String
  sku          service_skus @relation(fields: [skuId], references: [id], onDelete: Cascade)
  durationDays Int
  minQty       Int          @default(1)
  unitPrice    Decimal      @db.Decimal(20, 8)
  currency     String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([siteId, skuId, durationDays, minQty], map: "sku_price_overrides_scope_tier_key")
  @@index([siteId, skuId, durationDays, minQty], map: "sku_price_overrides_lookup_idx")
}

model user_sku_price_overrides {
  id           String       @id @default(uuid())
  siteId       String
  site         sites        @relation(fields: [siteId], references: [id])
  tenantId     String
  tenant       tenants      @relation(fields: [tenantId], references: [id])
  userId       String
  user         users        @relation(fields: [userId], references: [id])
  skuId        String
  sku          service_skus @relation(fields: [skuId], references: [id], onDelete: Cascade)
  durationDays Int
  minQty       Int          @default(1)
  unitPrice    Decimal      @db.Decimal(20, 8)
  currency     String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([siteId, userId, skuId, durationDays, minQty], map: "user_sku_price_overrides_scope_tier_key")
  @@index([siteId, tenantId, userId, skuId, durationDays, minQty], map: "user_sku_price_overrides_lookup_idx")
}

enum OrderType {
  STATIC_PROXY_BUY
  STATIC_PROXY_RENEW
}

enum OrderStatus {
  PENDING
  FULFILLING
  COMPLETED
  PARTIALLY_COMPLETED
  FAILED
  REFUNDED
}

enum FulfillmentJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  RETRYING
}

enum ProxyInstanceProtocol {
  HTTP
  SOCKS5
}

enum ProxyInstanceIpType {
  NATIVE
  BROADCAST
}

enum ProxyStatus {
  DELIVERING
  ACTIVE
  EXPIRING
  EXPIRED
  RELEASING
  RELEASED
  FAILED
}

model orders {
  id                     String                   @id @default(uuid())
  siteId                 String
  tenantId               String
  userId                 String
  user                   users                    @relation(fields: [userId], references: [id])
  type                   OrderType
  status                 OrderStatus
  resourceId             String
  resource               platform_resources       @relation(fields: [resourceId], references: [id])
  quantity               Int
  durationDays           Int
