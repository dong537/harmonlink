  tenantId           String
  tenant             tenants                        @relation(fields: [tenantId], references: [id])
  userId             String
  user               users                          @relation("LineMigrationUsers", fields: [userId], references: [id])
  dedicatedLineId    String
  dedicatedLine      dedicated_lines                @relation("LineMigrations", fields: [dedicatedLineId], references: [id], onDelete: Cascade)
  type               DedicatedLineMigrationType
  phase              DedicatedLineMigrationPhase    @default(PREPARE)
  status             DedicatedLineMigrationStatus   @default(ACTIVE)
  idempotencyKey     String
  requestedBy        String
  reason             String
  sourceLineVersion  Int
  targetLineVersion  Int
  sourcePlacementId  String
  targetPlacementId  String?
  sourceExitId       String
  sourceExit         residential_exits              @relation("MigrationSourceExit", fields: [sourceExitId], references: [id])
  targetExitId       String?
  targetExit         residential_exits?             @relation("MigrationTargetExit", fields: [targetExitId], references: [id])
  canaryRouteImportId String?
  canaryRouteImport  delivery_route_imports?        @relation("MigrationCanaryRoute", fields: [canaryRouteImportId], references: [id])
  cutoverRouteImportId String?
  cutoverRouteImport delivery_route_imports?        @relation("MigrationCutoverRoute", fields: [cutoverRouteImportId], references: [id])
  rollbackRouteImportId String?
  rollbackRouteImport delivery_route_imports?       @relation("MigrationRollbackRoute", fields: [rollbackRouteImportId], references: [id])
  activeLine         dedicated_lines?               @relation("ActiveLineMigration")
  nodes              dedicated_line_migration_nodes[]
  projections        dedicated_line_projections[]
  smokeObservations  dedicated_line_smoke_observations[]
  deliveryRoutes     delivery_routes[]
  recommendations    dedicated_line_migration_recommendations[]
  lastErrorCode      String?
  lastErrorDetail    Json?
  retryCount         Int                            @default(0)
  committedAt        DateTime?
  finishedAt         DateTime?
  createdAt          DateTime                       @default(now())
  updatedAt          DateTime                       @updatedAt

  @@unique([siteId, idempotencyKey])
  @@index([siteId, tenantId, userId, status, phase])
  @@index([dedicatedLineId, status, createdAt])
}

model dedicated_line_migration_nodes {
  id                String                           @id @default(uuid())
  migrationId       String
  migration         dedicated_line_migrations        @relation(fields: [migrationId], references: [id], onDelete: Cascade)
  nodeId            String
  node              control_nodes                   @relation(fields: [nodeId], references: [id])
  role              DedicatedLineMigrationNodeRole
  ordinal           Int
  reservedUnits     Int                              @default(0)
  reservationStatus MigrationNodeReservationStatus   @default(RESERVED)
  projectionId      String?
  createdAt         DateTime                         @default(now())
  releasedAt        DateTime?

  @@unique([migrationId, nodeId, role])
  @@unique([migrationId, role, ordinal])
  @@index([nodeId, reservationStatus])
}

model dedicated_line_smoke_observations {
  id              String                         @id @default(uuid())
  siteId          String
  site            sites                          @relation(fields: [siteId], references: [id])
  tenantId        String
  tenant          tenants                        @relation(fields: [tenantId], references: [id])
  userId          String
  user            users                          @relation("LineSmokeUsers", fields: [userId], references: [id])
  dedicatedLineId String
  dedicatedLine   dedicated_lines                 @relation(fields: [dedicatedLineId], references: [id], onDelete: Cascade)
  migrationId     String
  migration       dedicated_line_migrations       @relation(fields: [migrationId], references: [id], onDelete: Cascade)
  stage           MigrationSmokeStage
  hostname        String
  verified        Boolean                        @default(false)
  observedIp      String?
  observedCountryCode String?
  latencyMs       Int?
  failureType     String?
  failureDetail   Json?
  observedAt      DateTime                       @default(now())
  freshUntil      DateTime

  @@index([siteId, dedicatedLineId, migrationId, stage, observedAt])
}

model control_node_health_observations {
  id             String        @id @default(uuid())
  siteId         String
  site           sites         @relation(fields: [siteId], references: [id])
  nodeId         String
  node           control_nodes  @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  projectionKey  String?
  reachable      Boolean
  observedVersion Int?
  observedHash   String?
  latencyMs      Int?
  failureType    String?
  failureDetail  Json?
  observedAt     DateTime      @default(now())

  @@index([siteId, nodeId, observedAt])
}

model dedicated_line_migration_recommendations {
  id              String                           @id @default(uuid())
  siteId          String
  site            sites                            @relation(fields: [siteId], references: [id])
  tenantId        String
  tenant          tenants                          @relation(fields: [tenantId], references: [id])
  userId          String
  user            users                            @relation("MigrationRecommendationUsers", fields: [userId], references: [id])
  dedicatedLineId String
  dedicatedLine   dedicated_lines                  @relation(fields: [dedicatedLineId], references: [id], onDelete: Cascade)
  sourceNodeId    String
  sourceNode      control_nodes                    @relation("RecommendationSourceNode", fields: [sourceNodeId], references: [id])
  incidentVersion Int
  status          MigrationRecommendationStatus    @default(ACTIVE)
  reasonCode      String
  reasonDetail    Json?
  createdAt       DateTime                         @default(now())
  resolvedAt      DateTime?
  candidates      dedicated_line_migration_recommendation_nodes[]
  migrationId     String?
  migration       dedicated_line_migrations?        @relation(fields: [migrationId], references: [id], onDelete: SetNull)

  @@unique([dedicatedLineId, sourceNodeId, incidentVersion])
  @@index([siteId, tenantId, userId, status, createdAt])
}

model dedicated_line_migration_recommendation_nodes {
  id               String                           @id @default(uuid())
  siteId           String
  site             sites                            @relation(fields: [siteId], references: [id])
  recommendationId  String
  recommendation   dedicated_line_migration_recommendations @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  nodeId           String
  node              control_nodes                   @relation(fields: [nodeId], references: [id])
  rank             Int
  eligible         Boolean
  reasonCode       String?
  createdAt        DateTime                         @default(now())

  @@unique([recommendationId, nodeId])
  @@index([siteId, nodeId, eligible])
}

model delivery_route_domains {
  id              String          @id @default(uuid())
  deliveryRouteId String
  deliveryRoute   delivery_routes @relation(fields: [deliveryRouteId], references: [id], onDelete: Cascade)
  hostname        String
  port            Int
  isPrimary       Boolean         @default(false)
  createdAt       DateTime        @default(now())

  @@unique([deliveryRouteId, hostname, port])
  @@index([hostname, port])
}

model delivery_route_targets {
  id              String          @id @default(uuid())
  deliveryRouteId String
  deliveryRoute   delivery_routes @relation(fields: [deliveryRouteId], references: [id], onDelete: Cascade)
  nodeId          String
  node            control_nodes   @relation(fields: [nodeId], references: [id])
  targetPort      Int
  targetVersion   String
  createdAt       DateTime        @default(now())

  @@unique([deliveryRouteId, nodeId, targetPort, targetVersion])
  @@index([nodeId, targetPort, targetVersion])
}

model dedicated_line_inventory_snapshots {
  id                 String               @id @default(uuid())
  siteId             String
  site               sites                @relation(fields: [siteId], references: [id])
  providerAccountId  String
  providerAccount    provider_accounts    @relation(fields: [providerAccountId], references: [id])
  skuId              String
  sku                service_skus         @relation(fields: [skuId], references: [id])
  providerCode       String
  countryCode        String
  providerResourceId String
  quantity           Int
  reservedQuantity   Int                  @default(0)
  sourceVersion      String
  capturedAt         DateTime
  expiresAt          DateTime
  createdAt          DateTime             @default(now())
  reservations       stock_reservations[]

  @@unique([siteId, providerAccountId, skuId, countryCode, providerResourceId, sourceVersion], map: "line_inventory_snapshot_version_key")
  @@index([siteId, providerCode, skuId, countryCode, capturedAt])
  @@index([siteId, expiresAt])
}

model stock_reservations {
  id                   String                             @id @default(uuid())
  siteId               String
  site                 sites                              @relation(fields: [siteId], references: [id])
  tenantId             String
  tenant               tenants                            @relation(fields: [tenantId], references: [id])
  userId               String
  user                 users                              @relation(fields: [userId], references: [id])
  inventorySnapshotId  String
  inventorySnapshot    dedicated_line_inventory_snapshots @relation(fields: [inventorySnapshotId], references: [id])
  providerAccountId    String
  providerAccount      provider_accounts                  @relation(fields: [providerAccountId], references: [id])
  skuId                String
  sku                  service_skus                       @relation(fields: [skuId], references: [id])
  dedicatedLineOrderId String?                            @unique
  dedicatedLineOrder   dedicated_line_orders?             @relation(fields: [dedicatedLineOrderId], references: [id])
  providerCode         String
  countryCode          String
  quantity             Int
  snapshotVersion      String
  status               InventoryReservationStatus         @default(ACTIVE)
  idempotencyKey       String
  expiresAt            DateTime
  consumedAt           DateTime?
  releasedAt           DateTime?
  createdAt            DateTime                           @default(now())
  updatedAt            DateTime                           @updatedAt

  @@unique([siteId, tenantId, userId, idempotencyKey], map: "stock_reservations_scoped_idempotency_key")
  @@index([siteId, providerAccountId, skuId, countryCode, status, expiresAt])
  @@index([inventorySnapshotId, status])
}

model external_jobs {
  id                   String                 @id @default(uuid())
  siteId               String
  site                 sites                  @relation(fields: [siteId], references: [id])
  tenantId             String?
  tenant               tenants?               @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  userId               String?
  user                 users?                 @relation("ExternalJobUsers", fields: [userId], references: [id], onDelete: SetNull)
  dedicatedLineId      String?
  dedicatedLine        dedicated_lines?       @relation(fields: [dedicatedLineId], references: [id], onDelete: SetNull)
  dedicatedLineOrderId String?                @unique
  dedicatedLineOrder   dedicated_line_orders? @relation(fields: [dedicatedLineOrderId], references: [id])
  kind                 String
  aggregateType        String
  aggregateId          String
  desiredVersion       Int
  status               ExternalJobStatus      @default(QUEUED)
  attempt              Int                    @default(0)
  maxAttempts          Int                    @default(5)
  nextRunAt            DateTime               @default(now())
  leaseOwner           String?
  leaseExpiresAt       DateTime?
  idempotencyKey       String
  dedupeKey            String
  payload              Json
  lastErrorCode        String?
  lastErrorDetail      Json?
  completedAt          DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@unique([siteId, idempotencyKey])
  @@unique([siteId, dedupeKey])
  @@index([status, nextRunAt, leaseExpiresAt])
  @@index([siteId, tenantId, userId, aggregateType, aggregateId, desiredVersion])
}

model outbox_events {
  id              String            @id @default(uuid())
  siteId          String
  site            sites             @relation(fields: [siteId], references: [id])
  tenantId        String?
  tenant          tenants?          @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  userId          String?
  user            users?            @relation("OutboxEventUsers", fields: [userId], references: [id], onDelete: SetNull)
  dedicatedLineId String?
  dedicatedLine   dedicated_lines?  @relation(fields: [dedicatedLineId], references: [id], onDelete: SetNull)
  topic           String
  aggregateType   String
  aggregateId     String
  desiredVersion  Int
  status          OutboxEventStatus @default(PENDING)
  attempt         Int               @default(0)
  maxAttempts     Int               @default(5)
  nextRunAt       DateTime          @default(now())
  leaseOwner      String?
  leaseExpiresAt  DateTime?
  idempotencyKey  String
  dedupeKey       String
  payload         Json
  lastErrorCode   String?
  lastErrorDetail Json?
  publishedAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([siteId, idempotencyKey])
  @@unique([siteId, dedupeKey])
  @@index([status, nextRunAt, leaseExpiresAt])
  @@index([siteId, tenantId, userId, aggregateType, aggregateId, desiredVersion])
}
