{
  "name": "@ipeasy/api",
  "version": "0.0.1",
  "private": true,
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "typesVersions": {
    "*": {
      "worker": [
        "dist/worker.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "require": "./dist/main.js",
      "default": "./dist/main.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "require": "./dist/worker.js",
      "default": "./dist/worker.js"
    }
  },
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start:prod": "node dist/main",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "export:openapi": "ts-node -r tsconfig-paths/register scripts/export-openapi.ts",
    "seed:site": "ts-node -r tsconfig-paths/register scripts/seed-site.ts",
    "seed:pricing": "ts-node -r tsconfig-paths/register scripts/seed-pricing.ts",
    "seed:customer": "ts-node -r tsconfig-paths/register scripts/seed-customer.ts",
    "seed:admin": "ts-node -r tsconfig-paths/register scripts/seed-admin.ts",
    "seed:resources": "ts-node -r tsconfig-paths/register scripts/seed-resources.ts",
    "resources:apply-sale-policy": "ts-node -r tsconfig-paths/register scripts/apply-resource-sale-policy.ts",
    "resources:replay-provider-country-selection": "ts-node -r tsconfig-paths/register scripts/replay-provider-country-selection.ts",
    "provider:set-credential": "ts-node -r tsconfig-paths/register scripts/provider-credential.ts",
    "provider:bootstrap": "ts-node -r tsconfig-paths/register scripts/provider-bootstrap.ts",
    "providers:health-check": "ts-node -r tsconfig-paths/register scripts/providers-health-check.ts",
    "providers:sync-inventory": "ts-node -r tsconfig-paths/register scripts/providers-sync-inventory.ts",
    "providers:test-buy": "ts-node -r tsconfig-paths/register scripts/providers-test-buy.ts"
  },
  "dependencies": {
    "@fastify/static": "8.3.0",
    "@ipeasy/config": "workspace:*",
    "@ipeasy/db": "workspace:*",
    "@nestjs/common": "11.0.7",
    "@nestjs/config": "4.0.0",
    "@nestjs/core": "11.0.7",
    "@nestjs/platform-fastify": "11.0.7",
    "@nestjs/swagger": "11.4.4",
    "bcryptjs": "2.4.3",
    "decimal.js": "10.4.3",
    "fastify": "5.2.1",
    "http-proxy-agent": "7.0.2",
    "https-proxy-agent": "7.0.6",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "socks-proxy-agent": "8.0.5",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.2",
    "@nestjs/testing": "11.0.7",
    "@swc/core": "^1.15.40",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.10.5",
    "@types/supertest": "6.0.2",
    "@vitest/coverage-v8": "3.2.4",
    "supertest": "7.0.0",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.7.2",
    "unplugin-swc": "^1.5.9",
    "vitest": "3.2.4"
  }
}
