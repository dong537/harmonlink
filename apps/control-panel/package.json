  },
  "dependencies": {
    "@ipeasy/db": "workspace:*",
    "express": "^4.18.2",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/node": "^20.11.0",
    "esbuild": "^0.25.12",
    "tsx": "^4.7.0"
  }
}
